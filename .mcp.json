{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.1.14",
        "."
      ],
      "description": "Scoped filesystem access \u2014 enforces CAPABILITIES.md path restrictions. Restricts to project root by default."
    },
